{
  "$description": "Halyard design tokens. Source of truth: edit here, then run `npm run tokens`.",
  "color": {
    "dark": {
      "bg": "#0b0c0e",
      "bg-raise": "#121316",
      "bg-card": "#15171b",
      "bg-hover": "rgba(255,255,255,.04)",
      "bg-active": "rgba(255,255,255,.07)",
      "overlay": "rgba(24,26,31,.86)",
      "scrim": "rgba(5,6,8,.6)",
      "line": "rgba(255,255,255,.08)",
      "line-strong": "rgba(255,255,255,.14)",
      "fg": "#eceef2",
      "fg-2": "#a3a7b0",
      "fg-3": "#6b707a",
      "fg-inverse": "#0b0c0e",
      "signal": "#f2b66d",
      "signal-soft": "rgba(242,182,109,.15)",
      "ok": "#6fcf97",
      "info": "#7aa2f7",
      "danger": "#f07178",
      "lavender": "#c9a7f5",
      "btn-primary-bg": "#eceef2",
      "btn-primary-hover": "#ffffff",
      "thumb": "#23262d"
    },
    "light": {
      "bg": "#f7f7f8",
      "bg-raise": "#ffffff",
      "bg-card": "#ffffff",
      "bg-hover": "rgba(12,14,18,.04)",
      "bg-active": "rgba(12,14,18,.07)",
      "overlay": "rgba(255,255,255,.88)",
      "scrim": "rgba(20,22,26,.25)",
      "line": "rgba(12,14,18,.08)",
      "line-strong": "rgba(12,14,18,.15)",
      "fg": "#16181d",
      "fg-2": "#50555f",
      "fg-3": "#80858f",
      "fg-inverse": "#ffffff",
      "signal": "#b8711a",
      "signal-soft": "rgba(184,113,26,.14)",
      "ok": "#22875a",
      "info": "#3d6fd9",
      "danger": "#d0424e",
      "lavender": "#8a5cd1",
      "btn-primary-bg": "#16181d",
      "btn-primary-hover": "#000000",
      "thumb": "#ffffff"
    }
  },
  "font": {
    "sans": "\"Geist\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
    "mono": "\"Geist Mono\", ui-monospace, SFMono-Regular, Menlo, monospace"
  },
  "text": {
    "2xs": "11px",
    "xs": "12px",
    "sm": "13px",
    "base": "14px",
    "md": "16px",
    "lg": "17px",
    "xl": "20px",
    "2xl": "28px",
    "display-sm": "clamp(1.6rem, 3vw, 2.25rem)",
    "display-md": "clamp(2rem, 4.4vw, 3.3rem)",
    "display-lg": "clamp(2.6rem, 7vw, 5.25rem)"
  },
  "leading": {
    "tight": "1.05",
    "snug": "1.2",
    "normal": "1.55"
  },
  "tracking": {
    "display": "-0.04em",
    "title": "-0.02em",
    "label": "0.08em"
  },
  "space": {
    "0": "0",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "24": "96px"
  },
  "radius": {
    "xs": "5px",
    "sm": "7px",
    "md": "8px",
    "lg": "12px",
    "xl": "14px",
    "2xl": "20px",
    "full": "999px"
  },
  "shadow": {
    "window": "0 0 0 1px rgba(0,0,0,.6), 0 40px 120px -20px rgba(0,0,0,.8)",
    "overlay": "0 30px 80px -10px rgba(0,0,0,.7)",
    "btn-primary": "inset 0 1px 0 rgba(255,255,255,.6), 0 1px 2px rgba(0,0,0,.4)",
    "thumb": "inset 0 1px 0 rgba(255,255,255,.06), 0 1px 3px rgba(0,0,0,.4)"
  },
  "motion": {
    "ease-out": "cubic-bezier(.16,1,.3,1)",
    "ease-spring": "cubic-bezier(.34,1.56,.64,1)",
    "dur-fast": "150ms",
    "dur-base": "250ms",
    "dur-slow": "450ms",
    "dur-slower": "1000ms",
    "stagger": "90ms"
  },
  "layout": {
    "max": "1120px",
    "gutter": "16px",
    "nav-height": "60px",
    "sidebar": "220px"
  },
  "z": {
    "sticky": "40",
    "nav": "50",
    "overlay": "100",
    "toast": "200"
  }
}
