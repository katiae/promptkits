{
  "version": 1,
  "sdk_version": "3.0.6",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://bwvfogqulsblmownbcwo.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "promptkits",
      "version": "0.1.0",
      "title": "Promptkits"
    },
    "tools": [
      {
        "name": "search_templates",
        "title": "Search templates",
        "description": "List published interface templates, optionally filtered by text, category or tag.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "maxLength": 100,
              "description": "Words to match in the name or description."
            },
            "category": {
              "type": "string",
              "maxLength": 60,
              "description": "Exact category, e.g. 'Landing page'."
            },
            "tag": {
              "type": "string",
              "maxLength": 60,
              "description": "A single tag to filter by."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "Max results (default 20)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_template_prompt",
        "title": "Get template build prompt",
        "description": "Return a published template's full build prompt so an assistant can recreate it.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "Template slug from search_templates."
            }
          },
          "required": [
            "slug"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_saved_templates",
        "title": "List my saved templates",
        "description": "List the templates the signed-in user has saved (hearted).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
